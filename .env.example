# Copia este archivo como .env.local (nunca se sube al repositorio).
# NINGUNA de estas variables es un secreto: todo lo que empieza por VITE_ queda
# visible en el navegador. Las llaves secretas (pagos reales, etc.) NO van aquí.

# Correo de contacto para Nominatim (su política lo pide). Queda visible en el código público.
VITE_NOMINATIM_EMAIL=

# Modelo de Gemini (vía Firebase AI Logic). Por defecto: gemini-3.8-flash (nivel gratuito, sin facturación).
# VITE_GEMINI_MODEL=gemini-3.8-flash

# reCAPTCHA (v3 o Enterprise) para Firebase App Check: protege la cuota de Gemini frente a abuso.
# Sin esta variable, App Check no se activa (aceptable solo en desarrollo).
# VITE_APPCHECK_SITE_KEY=

# Token de CLIENTE de Mapillary (https://www.mapillary.com/dashboard/developers). Opcional:
# sin él, las fichas simplemente no muestran fotos de calle.
# VITE_MAPILLARY_TOKEN=

# true = emuladores locales (ya viene activo en .env.development). Pon false para usar Firebase real en dev.
# VITE_USE_EMULATORS=false

# Opcional · Clave de Geoapify Places (https://myprojects.geoapify.com), plan
# gratuito: 3.000 consultas/día. Se usa SOLO si Overpass no responde. Sin clave
# la app funciona igual, únicamente con Overpass.
# OJO: también queda visible en el navegador. En el panel de Geoapify, en la
# clave → "API key protection", permite solo estos orígenes:
#   https://locus-bb57e.firebaseapp.com
#   https://locus-bb57e.web.app
#   http://localhost:5173
VITE_GEOAPIFY_KEY=
