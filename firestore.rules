rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Proyecto propio de la app ("locus-bb57e"). Las reglas de la landing
    // (leads, stats) viven en su propio proyecto ("locus-landing").

    // --- Itinerarios generados ---
    // Cada itinerario pertenece a una sesión anónima (Firebase Anonymous Auth).
    // Solo su dueño puede leerlo o borrarlo; nadie puede reescribir el de otro.
    match /itineraries/{itineraryId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
                          && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Cualquier otra colección queda cerrada por defecto.
  }
}
