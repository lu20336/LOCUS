{
  "name": "locus-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n emu,web -c magenta,cyan \"npm:emulators\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:real": "vite --mode real",
    "emulators": "firebase emulators:start --only auth,firestore --project locus-bb57e",
    "seed": "tsx scripts/seed-emulator.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project locus-bb57e \"vitest run --config vitest.rules.config.ts\"",
    "demo:engine": "tsx scripts/demo-engine.ts",
    "demo:suggest": "tsx scripts/demo-suggest.ts",
    "data:towns": "tsx scripts/build-colombia-towns.ts",
    "deploy:rules": "firebase deploy --only firestore --project locus-bb57e",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project locus-bb57e",
    "deploy": "npm run build && firebase deploy --only firestore,hosting --project locus-bb57e",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview --project locus-bb57e",
    "data:reference": "tsx scripts/build-reference-data.ts",
    "data:activities": "tsx scripts/build-activity-availability.ts",
    "data:tourist-towns": "tsx scripts/build-tourist-towns.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.61.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
